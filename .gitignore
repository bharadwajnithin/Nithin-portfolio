# Ignore node_modules across subdirectories
node_modules/

# Ignore build and dist folders
build/
dist/

# Ignore compressed archives (e.g. portfolio-react-main.zip - 151MB)
*.zip
*.tar.gz
*.rar
*.7z

# Ignore environment files
.env
.env.*
*.env

# Ignore OS system files
.DS_Store
Thumbs.db
Desktop.ini

# Ignore IDE configs & log files
.vscode/
.idea/
*.log

# SSH keys -- NEVER commit private keys
*.pem
*.key
id_*
Start-Service*
